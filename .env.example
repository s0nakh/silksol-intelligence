# SilkSol Intelligence telemetry feeds. Public configuration — safe to commit. Copy to .env to change.
# Defaults replay the simulated Caspian scenario; "live" switches a feed on and falls back to
# simulation if it is unreachable.

# Caspian weather: "mock" or "live" (Open-Meteo forecast + marine API, free, no key).
VITE_WEATHER_MODE=mock

# Marine AIS: "mock" or "live". Live needs a proxy that returns RawAisPosition[] JSON
# (see src/services/telemetry/ais.ts) so provider API keys stay server-side.
VITE_AIS_MODE=mock
VITE_AIS_API_URL=
