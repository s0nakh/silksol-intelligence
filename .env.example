# SilkSol Intelligence telemetry feeds. Public configuration — safe to commit. Copy to .env to change.
# Defaults replay the simulated Caspian scenario; "live" switches a feed on and falls back to
# simulation if it is unreachable.

# Caspian weather: "mock" or "live" (Open-Meteo forecast + marine API, free, no key).
VITE_WEATHER_MODE=mock

# Marine AIS: "mock" or "live". Live needs a proxy that returns RawAisPosition[] JSON
# (see src/services/telemetry/ais.ts) so provider API keys stay server-side.
VITE_AIS_MODE=mock
VITE_AIS_API_URL=

# --- Server (Docker / QazCloud) -----------------------------------------------------------------
# Server-side feeds for the REST API (fall back to the VITE_* values above).
SILKSOL_WEATHER_MODE=mock
SILKSOL_AIS_MODE=mock
SILKSOL_AIS_API_URL=

# REST API keys: "client-name:secret" pairs, comma-separated, secrets ≥ 16 chars. Put real values
# in .env only. SILKSOL_API_AUTH=off disables keys for local demos.
SILKSOL_API_KEYS=
# SILKSOL_API_AUTH=off

# Optional Basic auth for the dashboard (unset = public demo).
SILKSOL_DASHBOARD_USER=
SILKSOL_DASHBOARD_PASSWORD=
